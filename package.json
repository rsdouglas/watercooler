  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^20.10.0",
    "typescript": "^5.3.3",
    "vitest": "^3.2.4"
  },
  "author": "True and Useful LLC",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  }
