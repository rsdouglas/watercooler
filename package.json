{
  "name": "@true-and-useful/watercooler",
  "version": "0.2.3",
  "description": "Local-first knowledge and coordination layer for AI coding agents via MCP",
  "repository": {
    "type": "git",
    "url": "https://github.com/rsdouglas/watercooler.git"
  },
  "workspaces": [
    "packages/*"
  ],
  "keywords": [
    "ai",
    "agents",
    "knowledge",
    "mcp",
    "model-context-protocol",
    "nuggets",
    "watercooler"
  ],
  "bin": {
